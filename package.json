{
  "name": "official-site-directory",
  "version": "0.1.0",
  "private": true,
  "description": "官网收录：只收录经过核验的官方网站，帮你一眼找到真官网",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.js",
    "build": "node scripts/validate.js && node scripts/build.js",
    "check-links": "node scripts/check-links.js",
    "serve": "npm run build && npx --yes serve dist",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "pinyin-pro": "^3.29.4"
  }
}
